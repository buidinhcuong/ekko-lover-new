# Chép tệp này thành `.env` rồi điền giá trị thật. `.env` đã được git bỏ qua.
#
#   cp app/.env.example app/.env
#
# Ở máy chủ, có thể đặt các biến này trong môi trường (systemd, Docker, Render…)
# thay cho tệp — biến trong môi trường thắng tệp. Xem DEPLOY.md.

# --- Chạy thật -------------------------------------------------------------
# production: tắt /dev/login, người dùng mẫu, dữ liệu mẫu; cookie có cờ Secure.
# BẮT BUỘC khi đưa cho người ngoài dùng.
NODE_ENV=
# Cổng và địa chỉ lắng nghe. Sau Nginx / Docker thì HOST=0.0.0.0.
PORT=4321
HOST=127.0.0.1
# Thư mục chứa database SQLite + ảnh hoá đơn. Phải nằm trên ổ đĩa bền và được sao lưu.
EKKO_DATA_DIR=
# Múi giờ tính ngày (streak, check-in, thử thách).
EKKO_TZ=Asia/Ho_Chi_Minh
# Chạy production trên mạng nội bộ KHÔNG có HTTPS thì đặt 1 (cookie bỏ cờ Secure).
EKKO_INSECURE_COOKIE=

# --- Bảo mật ---------------------------------------------------------------
# Chuỗi ngẫu nhiên dài (≥ 32 ký tự), mỗi môi trường một bộ. Để trống thì server
# tự sinh và lưu trong database (đổi database là mọi người phải đăng nhập lại).
#   openssl rand -hex 32
EKKO_SESSION_SECRET=
# Bí mật dùng chung với app Ekko để ký token SSO (chỉ cần khi nối SSO).
EKKO_SSO_SECRET=
# Email (hoặc mã người dùng Ekko) được quyền quản trị, cách nhau bằng dấu phẩy.
EKKO_ADMIN_SUBJECTS=
# Tài khoản quản trị mặc định — server tạo lúc khởi động nếu chưa có (cách nhanh nhất
# để có admin đầu tiên). Đăng nhập /admin/ bằng email + mật khẩu này rồi đổi mật khẩu
# trong app. Đã có tài khoản thì không ghi đè mật khẩu.
EKKO_ADMIN_EMAIL=
EKKO_ADMIN_PASSWORD=

# --- Đăng ký / đăng nhập bằng email (thử nghiệm nội bộ) ---------------------
# 0 = tắt hẳn (khi đã chạy qua SSO của app Ekko).
EKKO_LOCAL_AUTH=1
# Mã người thử phải nhập khi đăng ký (6–20 chữ/số). Để trống thì server tự sinh,
# in ra log lúc khởi động và Admin xem / đổi được ở Admin → Người học.
EKKO_SIGNUP_CODE=

# --- AI (Claude) -----------------------------------------------------------
# Khoá API của Anthropic — bật các tính năng AI: ghi nhanh chi tiêu (thanh ghi
# nhanh, "Nói để ghi", Ekko bot), đọc ảnh hoá đơn, tư vấn mục tiêu, và trả lời dự
# phòng của Ekko bot. Không có khoá thì các tính năng đó dùng bộ đọc / công thức
# viết sẵn, phần còn lại chạy bình thường.
ANTHROPIC_API_KEY=
# Model dùng cho các việc trên. Để trống là dùng mặc định claude-opus-5.
# Khuyến nghị: claude-sonnet-5-5 (rẻ hơn, đủ chính xác).
ANTHROPIC_MODEL=
